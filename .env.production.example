# ==============================================================================
# Smart Pali Production Environment Configuration (.env.production)
# ==============================================================================

# Database Settings (PostgreSQL container)
POSTGRES_USER=smart_pali
POSTGRES_PASSWORD=generate_a_strong_random_password_here_min_16_chars
POSTGRES_DB=smart_pali_prod

# Application Database Connection String
DATABASE_URL=postgresql://smart_pali:generate_a_strong_random_password_here_min_16_chars@db:5432/smart_pali_prod?schema=public

# NextAuth Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET=generate_a_base64_32_bytes_secret_here

# Public Application URL
APP_URL=http://localhost:3010

# Initial Data (Set to true on first run if you want demo/seed data in production)
RUN_SEED=false

# SMTP Mail Server (Optional - logs to console if left blank)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Smart Pali <no-reply@smartpali.org>

# OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Production Bootstrap (Optional - for npm run db:bootstrap)
BOOTSTRAP_ADMIN_EMAIL=admin@smartpali.org
BOOTSTRAP_ADMIN_PASSWORD=StrongAdminPasswordMin12Chars!
